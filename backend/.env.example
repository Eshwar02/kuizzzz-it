# Database
# Local dev (peer auth over Unix socket, role = your OS username):
DATABASE_URL=postgresql+psycopg://eshhh@/quiz_platform?host=/var/run/postgresql
# Hosted (e.g. Neon) would look like:
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Admin bootstrap (used by seed.py)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@quizzz.com
ADMIN_PASSWORD=admin12345

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# CORS
FRONTEND_ORIGIN=http://localhost:5173
